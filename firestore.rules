rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId} {
      function signedIn() {
        return request.auth != null;
      }

      function isMember() {
        return signedIn() && resource.data.memberIds.hasAny([request.auth.uid]);
      }

      function canEdit() {
        return isMember() && resource.data.members[request.auth.uid] in ['owner', 'editor'];
      }

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] in ['owner', 'editor', 'viewer']
        && request.resource.data.memberIds == [request.auth.uid];
      allow read: if isMember();
      allow update: if canEdit()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
